<?php
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $assetRepo = $objectManager->get(\Magento\Framework\View\Asset\Repository::class);

// Icons
$userIcon        = $assetRepo->getUrl("Vendor_GauravPageBuilderWidget::images/user.png");
$placeholderIcon = $assetRepo->getUrl("Vendor_GauravPageBuilderWidget::images/logged-user.png");
$wishlistIcon    = $assetRepo->getUrl("Vendor_GauravPageBuilderWidget::images/wishlist.png");
$cartIcon        = $assetRepo->getUrl("Vendor_GauravPageBuilderWidget::images/caviar_cart.png");

// If customer logged in → show user.png
// If guest → show placeholder.png
$finalUserIcon = $block->isLoggedIn() ? $placeholderIcon : $userIcon;
?>

<ul class="flex_icon">
    
    <!-- User / Account Icon -->
    <li>
        <a href="<?php echo $block->getUrl('customer/account'); ?>">
            <img src="<?php echo $finalUserIcon; ?>" alt="User" title="My Account" />
        </a>
    </li>

    <!-- Wishlist Icon -->
    <li>
        <a href="<?php echo $block->getUrl('wishlist'); ?>">
            <img src="<?php echo $wishlistIcon; ?>" alt="Wishlist" />
            <span class="wishlist-count cart_count_badge">
                <?php echo $block->getWishlistCount(); ?>
            </span>
        </a>
    </li>

    <!-- Cart Icon -->
    <li>
        <a href="<?php echo $block->getUrl('checkout/cart'); ?>">
            <img src="<?php echo $cartIcon; ?>" alt="Cart" />
            <span class="cart-count cart_count_badge">
                <?php echo $block->getCartCount(); ?>
            </span>
        </a>
    </li>

</ul>
