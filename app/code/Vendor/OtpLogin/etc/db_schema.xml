<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="vendor_otplogin_otp" resource="default" engine="innodb" comment="Vendor OTP Login">
        <column xsi:type="int" name="otp_id" nullable="false" unsigned="true" identity="true" comment="OTP ID"/>

        <column xsi:type="varchar" name="identifier" nullable="false" length="255" comment="Phone or Email"/>

        <column xsi:type="varchar" name="otp_hash" nullable="false" length="255" comment="Hashed OTP"/>

        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>

        <column xsi:type="timestamp" name="expires_at" nullable="true" default="NULL"/>

        <column xsi:type="int" name="attempts" nullable="false" default="0" comment="Attempts"/>

        <column xsi:type="tinyint" name="used" nullable="false" default="0" comment="Used"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="otp_id"/>
        </constraint>

        <index referenceId="VENDOR_OTPL_LOGIN_IDENTIFIER_IDX">
            <column name="identifier"/>
        </index>
    </table>

</schema>
