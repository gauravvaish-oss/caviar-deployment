<?php

 $objectManager = \Magento\Framework\App\ObjectManager::getInstance();

        $customerCollection = $objectManager
            ->get(\Magento\Customer\Model\ResourceModel\Customer\CollectionFactory::class)
            ->create()
            ->addAttributeToSelect('*'); // get all attributes including firstname, lastname, phone

        $orderCollectionFactory = $objectManager
            ->get(\Magento\Sales\Model\ResourceModel\Order\CollectionFactory::class);

        $result = [];

        foreach ($customerCollection as $customer) {

            // get orders of this customer
            $orders = $orderCollectionFactory->create()
                ->addFieldToFilter('customer_id', $customer->getId())
                ->addFieldToFilter('status', ['neq' => 'canceled']); // only non-cancelled

            $lifetimeOrders = $orders->count();
            $lifetimeSpent = 0;

            foreach ($orders as $order) {
                $lifetimeSpent += $order->getGrandTotal();
            }
          $addressRepo = $objectManager->create(\Magento\Customer\Api\AddressRepositoryInterface::class);

            // DEFAULT PHONE (empty initially)
            $phone = '';

            // Get billing & shipping IDs
            $billingId  = $customer->getDefaultBilling();
            $shippingId = $customer->getDefaultShipping();

            // 1️⃣ Try Billing Address First
            if (!empty($billingId)) {
                try {
                    $billingAddress = $addressRepo->getById($billingId);
                    $phone = $billingAddress->getTelephone();
                } catch (\Exception $e) {
                    $phone = '';
                }
            }

            // 2️⃣ If no phone & shipping exists → use shipping phone
            if (empty($phone) && !empty($shippingId)) {
                try {
                    $shippingAddress = $addressRepo->getById($shippingId);
                    $phone = $shippingAddress->getTelephone();
                } catch (\Exception $e) {
                    $phone = '';
                }
            }
            $result[] = [
                'name'   => $customer->getFirstname() . ' ' . $customer->getLastname(),
                'email'  => $customer->getEmail(),
                'phone'  => $phone,
                'orders' => $lifetimeOrders,
                'spent'  => number_format($lifetimeSpent, 2),
            ];
        }


?>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>DataTables HTML example</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

