    <style>
        body {
  margin: 0;
  font-family: system-ui, sans-serif;
  color: black;
  background-color: white;
}
</style>
</head>
  <body>
    <div id="app">
      <table id="myTable" class="display">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Lifetime Orders</th>
            <th>Lifetime Total Spent</th>
          </tr>
        </thead>
         <tbody>
            <?php foreach ($result as $row): ?>
            <tr>
                <td><?= $row['name'] ?></td>
                <td><?= $row['email'] ?></td>
                <td><?= $row['phone'] ?></td>
                <td><?= $row['orders'] ?></td>
                <td><?= $row['spent'] ?></td>
            </tr>
            <?php endforeach; ?>
        </tbody>
        </table>
    </div>
  </body>
  <script>
            require(['jquery', 'dataTables'], function($, dataTables) {
            $(document).ready(function() {
                $('#myTable').DataTable();
            });
        });
</script>
