        <div class="gmt-widget-container">
            <script type="text/javascript">
require(['jquery'], function($){
    $(document).ready(function(){

        // Poll until both icon and nav exist
        var interval = setInterval(function(){
            var $icon = $('.gmt-element-21935ea .gmt-icon i.fas.fa-bars'); // icon
            var $nav  = $('nav[data-action="navigation"]');                 // nav menu

            if($icon.length && $nav.length){
                clearInterval(interval); // stop polling

                // Attach click handler
                $icon.on('click', function(){
                    $nav.slideToggle(400);          // toggle menu
                    $(this).toggleClass('active');  // rotate icon
                });
            }
        }, 100); // check every 100ms

    });
});
</script>        </div>
        